# App
PORT=3000

# Telegram
TELEGRAM_TOKEN=your_telegram_token_here

# Discord
DISCORD_TOKEN=your_discord_token_here
DISCORD_CLIENT_ID=your_discord_client_id_here

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rekber_db
DB_USER=postgres
DB_PASS=your_db_password

# Payment Gateway (n8n / Transfer Manual)
PAYMENT_DANA_NUMBER=081234567890
PAYMENT_SEABANK_NUMBER=901234567890
PAYMENT_ACCOUNT_NAME=PortaPay Escrow
TRIPAY_API_KEY=isi_nanti
TRIPAY_PRIVATE_KEY=isi_nanti
TRIPAY_MERCHANT_CODE=isi_nanti

# Fee & Limits
FEE_PERCENT=1
MIN_WITHDRAW_AMOUNT=10000

# Admin Dashboard Config
ADMIN_PASSWORD=replace_with_unique_password_at_least_16_characters
# Optional only for local development; short password never works in production.
ADMIN_ALLOW_LOCAL_PASSWORD=false
# Optional Vite dev origin; omit when dashboard is served by Express.
ADMIN_ORIGIN=http://localhost:5173
# Store the same secret in an n8n Header Auth credential (x-webhook-secret).
N8N_WEBHOOK_SECRET=replace_with_random_secret_at_least_32_characters
# Exact account aliases emitted by the n8n parser, NOT account numbers.
PAYMENT_ALLOWED_ACCOUNTS=BLU_MAIN,DANA_MAIN,SEABANK_MAIN

# Mock Payment
MOCK_PAYMENT=true
BASE_URL=http://localhost:3000

# Dashboard Stats
STATS_UPDATE_INTERVAL_MINUTES=5
